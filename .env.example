# Copy to .env and fill in.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# Production only, e.g. https://leads.example.com
CSRF_TRUSTED_ORIGINS=

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://nycleads:nycleads@localhost:5432/nycleads

# NYC Open Data app token (free): https://data.cityofnewyork.us/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# Zip codes to scan, comma separated
TARGET_ZIP_CODES=10027,10030

# Optional: path to the downloaded OSE Class B list (.xls/.xlsx/.csv)
CLASS_B_LIST_FILE=

# Target rule: 0-1 Class A units and 1-15 Class B units
MAX_CLASS_A_UNITS=1
MIN_CLASS_B_UNITS=1
MAX_CLASS_B_UNITS=15
